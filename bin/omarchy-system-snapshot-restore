#!/bin/bash

# omarchy:summary=Roll the root subvolume back to a snapshot when Limine is absent
# omarchy:group=system
# omarchy:args=[--rehearse <mountpoint>]
# omarchy:requires-sudo=true
# omarchy:hidden=true

# omarchy-snapshot restore runs limine-snapper-restore, which ships with
# limine-snapper-sync -- a package Apple Silicon never installs, because limine
# cannot boot a Mac. So "restore" was a command not found on every Mac, and the
# snapshots taken before every update had no way back.
#
# This does the same job the way this layout allows: take a writable snapshot of
# the chosen one, move the live @ aside, and put the new one in its place. That
# is what the boot mounts, since fstab and the kernel command line both name
# subvol=@ outright -- which is also why snapper's own rollback, which works by
# changing the default subvolume, would do nothing here.
#
# The displaced @ is kept as @old-<timestamp>: the undo, until you delete it.
#
# --rehearse <mountpoint> runs the same swap on a scratch btrfs filesystem
# mounted at its top level (subvolid=5), choosing by OMARCHY_SNAPSHOT_RESTORE_CHOICE
# (1-based) and skipping the typed confirmation. Never touches the running root.

set -euo pipefail

TOP=/run/omarchy-snapshot-restore
REHEARSE=0

log() {
  printf '\033[32m==>\033[0m %s\n' "$*"
}

warn() {
  printf '\033[33mWarning:\033[0m %s\n' "$*" >&2
}

fail() {
  printf '\033[31mError:\033[0m %s\n' "$*" >&2
  exit 1
}

# Where a snapper snapshot lives when read from the top of the tree. Snapper
# makes .snapshots a subvolume inside the root it snapshots, so a root mounted
# from @ puts them under @/.snapshots.
snapshot_subvol_path() {
  printf '@/.snapshots/%s/snapshot' "$1"
}

# number<TAB>date<TAB>description, oldest first, for every snapshot snapper has
# of the root config. Columns are looked up by name from the header rather than
# by position: snapper's --csvout has gained columns between versions, and
# reading the wrong one silently offers to restore the wrong thing.
list_snapper_snapshots() {
  snapper -c root --csvout list 2>/dev/null |
    awk -F, '
      NR == 1 {
        for (i = 1; i <= NF; i++) {
          gsub(/^"|"$/, "", $i)
          col[$i] = i
        }
        next
      }
      {
        number = $col["number"]
        gsub(/^"|"$/, "", number)
        # 0 is the running system, not a snapshot to go back to.
        if (number == "" || number == "0") next
        date = col["date"] ? $col["date"] : ""
        description = col["description"] ? $col["description"] : ""
        gsub(/^"|"$/, "", date)
        gsub(/^"|"$/, "", description)
        printf "%s\t%s\t%s\n", number, date, description
      }'
}

# The same listing read off the tree itself, for --rehearse: the scratch
# filesystem is not the one snapper's root config describes. Date and
# description come from snapper's info.xml when one is there.
list_store_snapshots() {
  local top=$1 dir entry number date description
  for dir in "$top"/@/.snapshots/[0-9]*/snapshot; do
    [[ -d $dir ]] || continue
    entry=${dir%/snapshot}
    number=${entry##*/}
    date=""
    description=""
    if [[ -f $entry/info.xml ]]; then
      date=$(sed -n 's:.*<date>\(.*\)</date>.*:\1:p' "$entry/info.xml" | head -1)
      description=$(sed -n 's:.*<description>\(.*\)</description>.*:\1:p' "$entry/info.xml" | head -1)
    fi
    printf '%s\t%s\t%s\n' "$number" "$date" "$description"
  done | sort -n
}

# One row of the menu: what the snapshot is, then what is inside it. The second
# half is the part that prevents a wrong pick -- "snapshot 3" says nothing about
# whether it predates Omarchy, and choosing a mid-install snapper snapshot gives
# a machine with the packages installed but no display manager, which reads as a
# broken install rather than a wrong choice.
choice_label() {
  local summary="$1" path="$2"
  printf '%s  --  %s' "$summary" "$(describe_subvolume "$path")"
}

describe_subvolume() {
  local path="$1" version
  if [[ -f $TOP/$path/usr/share/omarchy/version ]]; then
    version=$(head -1 "$TOP/$path/usr/share/omarchy/version" 2>/dev/null || echo unknown)
    printf 'Omarchy %s is installed in it' "$version"
  else
    printf 'no Omarchy installed in it'
  fi
}

# Everything after the confirmation works against $top, the filesystem mounted
# at its top level. Kept as functions so the tests can drive them against a
# scratch tree and --rehearse against a scratch filesystem.
#
# Two renames, not one: there is no atomic exchange from a shell. The window is
# a few milliseconds, and main prints what to do if a crash lands inside it.
swap_root() {
  local top=$1 source_path=$2 stamp=$3
  btrfs subvolume snapshot "$top/$source_path" "$top/@new" >/dev/null
  mv "$top/@" "$top/@old-$stamp"
  mv "$top/@new" "$top/@"
}

# Snapper keeps its store as a subvolume nested inside @, and a btrfs snapshot
# does not carry nested subvolumes: what a snapshot of @ holds at .snapshots is
# an empty directory. So after the swap the store, with every snapshot ever
# taken, has moved aside inside @old-*, and the live root has a placeholder
# where snapper expects a subvolume. Bring the store back so snapper -- and the
# snapshot omarchy-update takes before every update -- keep working, and so
# @old-* holds nothing nested and deletes with one command. Baselines (@fresh,
# @factory) carry no placeholder at all; the move creates the name.
#
# Renaming a subvolume into another parent subvolume is the one cross-subvolume
# rename btrfs allows, so this is a rename, not a copy.
move_snapshot_store() {
  local top=$1 old=$2 new=$3
  # No snapper store in the displaced root: nothing to carry.
  btrfs subvolume show "$top/$old/.snapshots" >/dev/null 2>&1 || return 0
  if [[ -e $top/$new/.snapshots || -L $top/$new/.snapshots ]]; then
    if [[ -L $top/$new/.snapshots || ! -d $top/$new/.snapshots ]] || ! rmdir "$top/$new/.snapshots" 2>/dev/null; then
      warn "$new/.snapshots in the restored root is not the empty placeholder a snapshot leaves; the store was not moved over it."
      return 2
    fi
  fi
  mv "$top/$old/.snapshots" "$top/$new/.snapshots"
  btrfs subvolume show "$top/$new/.snapshots" >/dev/null
}

cleanup() {
  (( REHEARSE )) && return 0
  mountpoint -q "$TOP" && umount "$TOP" 2>/dev/null || true
  [[ -d $TOP ]] && rmdir "$TOP" 2>/dev/null || true
}

main() {
  local rehearse_top=""
  while (( $# )); do
    case $1 in
      --rehearse)
        [[ -n ${2:-} ]] || fail "--rehearse needs a mountpoint"
        rehearse_top=$2
        shift 2
        ;;
      *) fail "unknown argument: $1" ;;
    esac
  done

  (( EUID == 0 )) || fail "run as root"

  local root_source
  if [[ -n $rehearse_top ]]; then
    REHEARSE=1
    TOP=$rehearse_top
    mountpoint -q "$TOP" || fail "$TOP is not a mountpoint"
    [[ $(findmnt -no FSTYPE "$TOP") == "btrfs" ]] || fail "$TOP is not btrfs"
    [[ -d $TOP/@ ]] || fail "$TOP has no @ subvolume; mount the filesystem's top level (subvolid=5)"
    root_source=$(findmnt -no SOURCE "$TOP" | sed 's/\[.*\]//')
    log "Rehearsing against $root_source at $TOP"
  else
    root_source=$(findmnt -no SOURCE / | sed 's/\[.*\]//')
    [[ $(findmnt -no FSTYPE /) == "btrfs" ]] || fail "/ is not btrfs; nothing to roll back to"
    findmnt -no OPTIONS / | grep -q 'subvol=/@\(,\|$\)' ||
      fail "/ is not mounted from the @ subvolume; this layout is not supported"

    trap cleanup EXIT
    mkdir -p "$TOP"
    mount -o subvolid=5 "$root_source" "$TOP"
  fi

  # Snapper's snapshots, plus the two the install leaves behind: @fresh (the
  # system before Omarchy) and @factory (the installed system before it was
  # anyone's).
  local -a labels=() paths=()
  local number date description path

  local baseline
  for baseline in @fresh @factory; do
    [[ -d $TOP/$baseline ]] || continue
    case $baseline in
      @fresh) labels+=("$(choice_label "@fresh    the system as it was before Omarchy was installed" "$baseline")") ;;
      @factory) labels+=("$(choice_label "@factory  the installed system, before it was anyone's" "$baseline")") ;;
    esac
    paths+=("$baseline")
  done

  local listing
  if (( REHEARSE )); then
    listing=$(list_store_snapshots "$TOP")
  else
    listing=$(list_snapper_snapshots)
  fi
  while IFS=$'\t' read -r number date description; do
    [[ -n $number ]] || continue
    path=$(snapshot_subvol_path "$number")
    [[ -d $TOP/$path ]] || continue
    labels+=("$(choice_label "snapshot $number  $date  ${description:-no description}" "$path")")
    paths+=("$path")
  done <<<"$listing"

  (( ${#paths[@]} )) || fail "no snapshots found to restore"

  local choice=""
  if (( REHEARSE )); then
    local picked=${OMARCHY_SNAPSHOT_RESTORE_CHOICE:-}
    [[ $picked =~ ^[0-9]+$ ]] && (( picked >= 1 && picked <= ${#labels[@]} )) ||
      fail "set OMARCHY_SNAPSHOT_RESTORE_CHOICE to 1..${#labels[@]} for a rehearsal"
    choice=${labels[$((picked - 1))]}
  elif omarchy-cmd-present gum; then
    choice=$(printf '%s\n' "${labels[@]}" | gum choose --header "Restore which snapshot?") || exit 1
  else
    local i
    for i in "${!labels[@]}"; do
      printf '%3d) %s\n' "$((i + 1))" "${labels[$i]}"
    done
    local picked
    read -rp "Restore which? [1-${#labels[@]}] " picked
    [[ $picked =~ ^[0-9]+$ ]] && (( picked >= 1 && picked <= ${#labels[@]} )) ||
      fail "not a choice"
    choice=${labels[$((picked - 1))]}
  fi

  local index=-1 i
  for i in "${!labels[@]}"; do
    [[ ${labels[$i]} == "$choice" ]] && index=$i && break
  done
  (( index >= 0 )) || fail "could not match that choice"

  local source_path=${paths[$index]}
  local stamp
  stamp=$(date +%s)

  echo
  log "Restoring ${labels[$index]}"
  log "  subvolume: $source_path"
  log "  contents:  $(describe_subvolume "$source_path")"
  log "The current root is kept as @old-$stamp until you delete it."
  warn "/boot is the EFI partition and is not part of any snapshot: the kernel"
  warn "and initramfs stay as they are. After rolling back across a kernel"
  warn "update, run 'sudo mkinitcpio -P'."
  echo
  if (( ! REHEARSE )); then
    local typed
    read -rp "Type 'restore' to continue: " typed
    [[ $typed == "restore" ]] || fail "not confirmed"
  fi

  if ! swap_root "$TOP" "$source_path" "$stamp"; then
    warn "The swap did not complete. Boot may fail with no @ to mount. From a"
    warn "rescue shell, mount the filesystem's top level and rename so exactly"
    warn "one of @new / @old-$stamp is called @:"
    warn "  mount -o subvolid=5 $root_source /mnt && ls /mnt"
    fail "root swap failed"
  fi

  if ! move_snapshot_store "$TOP" "@old-$stamp" "@"; then
    warn "The snapshot store stayed at @old-$stamp/.snapshots. The restored root"
    warn "boots, but snapper cannot see earlier snapshots until it is moved back:"
    warn "  sudo mount -o subvolid=5 $root_source /mnt"
    warn "  sudo rmdir /mnt/@/.snapshots; sudo mv /mnt/@old-$stamp/.snapshots /mnt/@/.snapshots"
    exit 1
  fi

  # /boot is the ESP and outside every snapshot, so the restored root is now
  # paired with whatever kernel is on it. If the install updated linux-asahi
  # after this snapshot, that kernel has no modules in here.
  local running restored_kernels
  running=$(uname -r)
  restored_kernels=$(cd "$TOP/@/usr/lib/modules" 2>/dev/null && echo * || echo "")
  if [[ -n $restored_kernels && " $restored_kernels " != *" $running "* ]]; then
    echo
    warn "The restored system has modules for: $restored_kernels"
    warn "The kernel currently on /boot is $running, which is not among them."
    warn "Reinstall the kernel from the restored system, or expect missing"
    warn "drivers -- Wi-Fi and the display among them."
  fi

  echo
  log "Restored. Reboot to run from it. Snapper's snapshot store came along, so"
  log "earlier snapshots are still listed and the next update still takes one."
  log "@old-$stamp holds nothing nested; when you are sure, delete it with:"
  log "  sudo mount -o subvolid=5 $root_source /mnt && sudo btrfs subvolume delete /mnt/@old-$stamp"
  log "If it is not what you wanted, from a shell on the restored system:"
  log "  sudo mount -o subvolid=5 $root_source /mnt"
  log "  sudo mv /mnt/@ /mnt/@discard && sudo mv /mnt/@old-$stamp /mnt/@"
  log "  sudo mv /mnt/@discard/.snapshots /mnt/@/.snapshots && sudo reboot"
}

# Sourcing the script exposes its functions to the tests without running
# anything; executing it does the work.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
